# Causiq configuration surface.
#
# Copy to `.env` and fill in. `.env` is gitignored and must never be committed.
# Every value below is read and validated at process start (src/causiq/config.py);
# an invalid value fails fast with a readable message rather than at minute nine
# of an investigation.

# --- Anthropic -------------------------------------------------------------
# Read directly by the Anthropic SDK. Causiq only records whether it is present;
# the value is never logged, never written to an audit record, and never
# rendered in error output.
# Required from P0.6 onward. The default (offline) test suite does not need it.
ANTHROPIC_API_KEY=

# --- Runtime ---------------------------------------------------------------
CAUSIQ_ENVIRONMENT=local          # local | ci | prod
CAUSIQ_LOG_LEVEL=INFO             # DEBUG | INFO | WARNING | ERROR
CAUSIQ_LOG_FORMAT=json            # json | console

# --- Model policy (Engineering Contract 6.1 / 6.2) -------------------------
CAUSIQ_MODEL_ID=claude-opus-5
CAUSIQ_MODEL_EFFORT=high          # low | medium | high | xhigh | max
CAUSIQ_MODEL_MAX_TOKENS=16000

# --- Run budget (invariant I5) ---------------------------------------------
CAUSIQ_BUDGET_MAX_TURNS=12
CAUSIQ_BUDGET_MAX_TOOL_CALLS=24
CAUSIQ_BUDGET_MAX_TOTAL_TOKENS=400000
CAUSIQ_BUDGET_DEADLINE_SECONDS=600

# --- Storage ---------------------------------------------------------------
CAUSIQ_AUDIT_DIR=var/audit        # append-only run journals (invariant I7)
